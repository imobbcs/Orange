# whentobuybtc.xyz: environment variables (set these on Railway; copy to .env.local for local dev)

DATABASE_URL=postgres://user:pass@host:5432/db
RESEND_API_KEY=
REPLY_TO_EMAIL=
CRON_SECRET=

COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
FRED_API_KEY=
UMAMI_PASSWORD=

# Optional
# NEXT_PUBLIC_BASE_URL=https://whentobuybtc.xyz
# MACRO_CONTEXT=off            # off | test | on  (market block in emails)
# MACRO_CONTEXT_TEST_EMAIL=

# Alerts when a scheduled job fails or stops running (healthchecks.io ping URLs, one check per job)
# HEALTHCHECK_URL_SIGNAL=      # /api/check-signal
# HEALTHCHECK_URL_DIGEST=      # /api/weekly-digest
# HEALTHCHECK_URL_BACKUP=      # /api/admin/backup
# BACKUP_EMAIL=                # where the weekly subscriber CSV goes (default: REPLY_TO_EMAIL)

# X bot (twitter-bot/, run by the Railway cron services)
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=
# POST_TYPE=signal             # "signal" or "bullish", set per cron service
# HEALTHCHECK_URL=             # per cron service: its own healthchecks.io ping URL
