# whentobuybtc.xyz: environment variables (set these on Railway; copy to .env.local for local dev)

DATABASE_URL=postgres://user:pass@host:5432/db
RESEND_API_KEY=
REPLY_TO_EMAIL=
CRON_SECRET=

COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
FRED_API_KEY=
UMAMI_PASSWORD=

